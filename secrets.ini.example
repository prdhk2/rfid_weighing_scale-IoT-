; Copy to secrets.ini (gitignored) and fill in. Read by scripts/load_secrets.py
; at build time; every key becomes a -D define consumed by include/config.h.
;
; The release env (pio run -e release) refuses to compile unless
; DP_MQTT_USER and DP_MQTT_PASS are set and there is a Wi-Fi SSID (here or
; the default in include/config.h).
;
; Easiest: on the server run
;   bash scripts/provision-device.sh depok-truk-01 --site depok_truk
; copy the secrets.ini it writes, then fill in the DP_WIFI_* lines if needed.
; Comments must be on their own line.

[secrets]
; Site Wi-Fi. Leave empty to use the defaults in include/config.h.
DP_WIFI_SSID =
DP_WIFI_PASS =

; Broker login. The username MUST equal DP_DEVICE_ID (default
; depok-truk-01): the broker ACL only lets a device publish to
; depok_truk/<its own username>/...
DP_MQTT_USER =
DP_MQTT_PASS =

; Optional. /api/weightDataIn and /weightDataOut need no key today; if one is
; set it is sent as X-API-KEY anyway, so the server can start requiring it.
DP_API_KEY =

; Optional overrides - leave empty to keep the defaults in config.h.
DP_DEVICE_ID =
DP_API_BASE_URL =
DP_MQTT_HOST =
DP_MQTT_PORT =
